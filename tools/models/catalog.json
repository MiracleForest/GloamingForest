      { "suffix": "held_left", "frame": "leftArm", "slot": "off_hand", "kind": "held",
        "source": "ItemInHandLayer (left arm) + the item model's 'thirdperson_lefthand' display (leftHand: x, y and z rotation mirrored) + ItemRenderer (builtin/entity) + ISTER + TrophyRenderer.render(null, 180, THIRD_PERSON_LEFT_HAND)",
        "prefix": ["item_in_left_hand", ["display", "thirdperson_lefthand"], "builtin_entity_item", "trophy_item"] }
