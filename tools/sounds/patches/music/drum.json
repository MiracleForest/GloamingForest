{
  "about": "Soft hand drum.",
  "params": {
    "freq": 110,
    "dur": 0.3,
    "vel": 1
  },
  "length": 0.01,
  "tail": 0.6,
  "normalize": -3,
  "layers": [
    {
      "type": "modal",
      "modes": "drum",
      "freq": "$freq",
      "strike": 0.006,
      "ring": 0.5
    },
    {
      "type": "osc",
      "wave": "sine",
      "freq": {
        "from": "$freq*1.6",
        "to": "$freq*0.9",
        "time": 0.08
      },
      "amp": 0.6,
      "length": 0.25,
      "env": {
        "a": 0.001,
        "d": 0.15,
        "s": 0,
        "r": 0.05
      }
    }
  ]
}
