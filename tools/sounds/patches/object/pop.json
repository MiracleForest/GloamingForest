{
  "about": "Pop: a short falling sine blip.",
  "params": {
    "pitch": 900,
    "len": 0.08
  },
  "length": "$len",
  "tail": 0.05,
  "layers": [
    {
      "type": "osc",
      "wave": "sine",
      "freq": {
        "env": [
          [
            0,
            "$pitch*1.8"
          ],
          [
            "$len",
            "$pitch*0.7"
          ]
        ],
        "curve": "exp"
      },
      "env": {
        "a": 0.001,
        "d": "$len*0.6",
        "s": 0.0,
        "r": 0.02
      }
    }
  ]
}
