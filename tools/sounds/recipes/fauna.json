{
  "about": "U16 fauna: refinements of the baseline (tools/sounds/baseline/fauna.json). Original sound designs; TF's audio is never read. The events (ids, subtitles, categories, volumes, pitches, variant counts) stay TF's. The deer lows (TF's subtitle: 'Deer moos'): a soft nasal bellow with a thin bleat on top, a yelp when hurt and a long falling bellow when it dies. The kobold grumbles in a gruff little voice over a throat growl. The mosquito swarm is several detuned whines drifting around each other over a faint wing hum. The penguin honks (a dark nasal caw), the raven caws hoarse and squawks raw, the squirrel chitters (quick chirps over a tiny rattle) and the tiny bird chirps and sings short phrases. The parrot imitations play the imitated owners' events (TF's pitch 1.8, volume 0.6).",
  "patches": {
    "deer/voice": {
      "about": "Deer bellow: a nasal o-to-u call with breath, a thin bleat an octave up, a short room.",
      "params": {"pitch": 300, "len": 0.6, "rise": 1, "fall": -4, "rough": 1.4, "bleat": -14},
      "length": "$len", "tail": 0.3,
      "layers": [
        {"type": "patch", "patch": "creature/call", "length": "$len+0.4", "params": {"pitch": "$pitch", "len": "$len", "rise": "$rise", "fall": "$fall", "vowelA": 3, "vowelB": 4, "size": 1.05, "rough": "$rough", "breath": 0.3, "vib": 0.35, "vibRate": 5}},
        {"type": "patch", "patch": "creature/bleat", "length": "$len+0.4", "gain": "$bleat", "params": {"pitch": "$pitch*2", "len": "$len*0.8", "size": 1.3, "vib": 0.6}}
      ],
      "fx": [{"type": "filter", "filter": "hp", "freq": 110}, {"type": "reverb", "room": 0.35, "mix": 0.08}]
    },
    "kobold/grumble": {
      "about": "Kobold grumble: gruff chatter over a throat growl.",
      "params": {"pitch": 330, "count": 3},
      "length": "$count*0.14+0.1", "tail": 0.25,
      "layers": [
        {"type": "patch", "patch": "creature/chatter", "length": "$count*0.16+0.4", "params": {"pitch": "$pitch", "count": "$count", "syll": 0.13, "size": 1.45, "rough": 2.4}},
        {"type": "patch", "patch": "creature/growl", "length": "$count*0.16+0.4", "gain": -9, "params": {"pitch": "$pitch*0.35", "len": "$count*0.13", "size": 1.1, "rough": 2, "rasp": 0.25, "rumble": 30}}
      ]
    },
    "mosquito/swarm": {
      "about": "Mosquito swarm: three detuned whines that drift past each other and a faint wing-beat hum.",
      "params": {"pitch": 620, "len": 1.6},
      "length": "$len", "tail": 0.2,
      "layers": [
        {"type": "patch", "patch": "creature/whine", "length": "$len+0.3", "params": {"pitch": "$pitch", "len": "$len"}},
        {"type": "patch", "patch": "creature/whine", "length": "$len+0.3", "start": 0.12, "gain": -4, "params": {"pitch": "$pitch*1.09", "len": "$len*0.85"}},
        {"type": "patch", "patch": "creature/whine", "length": "$len+0.3", "start": 0.3, "gain": -7, "params": {"pitch": "$pitch*0.9", "len": "$len*0.7"}},
        {"type": "noise", "color": "pink", "amp": 0.12, "env": {"a": 0.2, "d": "$len*0.5", "s": 0.6, "r": 0.2}, "tremolo": {"rate": 310, "depth": 0.8}, "filter": [{"type": "bp", "freq": 650, "q": 2}]}
      ],
      "fx": [{"type": "chorus", "rate": 0.9, "depth": 0.004, "mix": 0.4}]
    },
    "squirrel/chitter": {
      "about": "Squirrel chitter: quick rising chirps over a tiny fast rattle.",
      "params": {"f0": 2900, "count": 5},
      "length": "$count*0.065+0.05", "tail": 0.1,
      "layers": [
        {"type": "patch", "patch": "creature/chirp", "length": "$count*0.07+0.2", "params": {"f0": "$f0", "f1": "$f0*1.5", "len": 0.04, "count": "$count", "gap": 0.065, "spread": 3}},
        {"type": "patch", "patch": "creature/rattle", "length": "$count*0.07+0.2", "gain": -10, "params": {"len": "$count*0.06", "rate": 46, "freq": 4200, "q": 6}}
      ]
    },
    "bird/song": {
      "about": "Tiny bird song: two short chirp phrases, the second higher and quicker.",
      "params": {"f0": 3200},
      "length": 1.5, "tail": 0.2,
      "layers": [
        {"type": "patch", "patch": "creature/chirp", "length": 1.0, "params": {"f0": "$f0", "f1": "$f0*1.7", "len": 0.075, "count": 6, "gap": 0.12, "spread": 5}},
        {"type": "patch", "patch": "creature/chirp", "start": 0.78, "length": 0.8, "gain": -2, "params": {"f0": "$f0*1.25", "f1": "$f0*1.9", "len": 0.05, "count": 5, "gap": 0.085, "spread": 3}}
      ],
      "fx": [{"type": "reverb", "room": 0.45, "mix": 0.12}]
    }
  },
