{
  "about": "U25 stronghold: refinements of the baseline (tools/sounds/baseline/stronghold.json). Original sound designs; TF's audio is never read. The events (ids, subtitles, categories, volumes, pitches, variant counts) stay TF's; as in TF the goblin knights and the block-and-chain goblin play the redcap files and the Knight Phantom plays the wraith files, with U17 hostiles' designs of them. A file TF shares with another owner keeps one design in every owner's recipe (the same patch, parameters and seed), so it sounds the same wherever TF plays it. The goblins chuckle in breathy 'heh' syllables, screech when hurt and groan as they die; the muffled set (TF's own files, for an armoured lower knight) is the same voice inside a helmet: dull, low-passed, with the ring of the metal shell. The Helmet Crab snips its claws twice, clicks along on its legs and squeaks when hurt. The trophy pedestal stands in for the zombie infection snarl TF plays (Bedrock has no file): a rasping snarl with a stone thunk and a faint ring.",
  "patches": {
    "redcap/chuckle": {"about": "Goblin chuckle: short breathy 'heh' syllables falling in pitch.", "params": {"pitch": 260, "count": 5, "syll": 0.085, "size": 1.35, "rough": 2.0}, "length": "$count*$syll*1.3", "tail": 0.2, "layers": [{"type": "osc", "wave": "saw", "length": "$syll", "freq": {"env": [[0, "$pitch*semi(rand(1,4))"], ["$syll", "$pitch*semi(rand(-3,0))"]], "curve": "exp"}, "env": {"a": 0.006, "d": "$syll*0.6", "s": 0.4, "r": 0.03}, "formant": {"vowel": "rand(0.7,1.4)", "shift": "$size", "mix": 0.85}, "drive": "$rough", "repeat": {"count": "$count", "every": "$syll*1.3", "jitter": 0, "decay": 0.88}}, {"type": "noise", "color": "pink", "amp": 0.3, "length": "$syll*0.7", "env": {"a": 0.004, "d": "$syll*0.5", "s": 0.1, "r": 0.02}, "filter": [{"type": "bp", "freq": "2200*$size", "q": 1.2}], "repeat": {"count": "$count", "every": "$syll*1.3", "jitter": 0, "decay": 0.88}}], "fx": [{"type": "filter", "filter": "hp", "freq": 140}, {"type": "filter", "filter": "lp", "freq": "5200*$size", "stages": 2}, {"type": "reverb", "room": 0.2, "mix": 0.06}]},
    "wraith/gasp": {"about": "Wraith gasp: a sharp whispered inhale, then a falling ghostly moan in a large room.", "params": {"pitch": 200, "len": 1.3, "glide": -6}, "length": "$len+0.3", "tail": 0.6, "layers": [{"type": "noise", "color": "white", "length": 0.32, "env": {"env": [[0, 0], [0.26, 1], [0.32, 0]], "curve": "smooth"}, "filter": [{"type": "bp", "freq": {"from": 1400, "to": 3200, "time": 0.3}, "q": 1.6}], "gain": -3}, {"type": "patch", "patch": "creature/ghost", "start": 0.28, "length": "$len+1.2", "params": {"pitch": "$pitch", "len": "$len", "glide": "$glide", "whisper": 0.5, "room": 0.85, "vowelA": 0, "vowelB": 4}}]},
    "goblin/helmet": {"about": "A goblin voice inside a helmet: low-passed, with the ringing resonance of the metal shell.", "params": {"voice": 0, "pitch": 240, "count": 5, "len": 0.5, "rise": 2, "fall": -5, "rough": 2.6, "syll": 0.085}, "length": "$len+0.2", "tail": 0.3, "layers": [{"type": "patch", "patch": "redcap/chuckle", "amp": "1-$voice", "length": "$len+0.6", "params": {"pitch": "$pitch", "count": "$count", "syll": "$syll"}}, {"type": "patch", "patch": "creature/call", "amp": "$voice", "length": "$len+0.6", "params": {"pitch": "$pitch", "len": "$len", "rise": "$rise", "fall": "$fall", "size": 1.25, "rough": "$rough", "breath": 0.3, "vowelA": 0, "vowelB": 4}}], "fx": [{"type": "filter", "filter": "lp", "freq": 950, "stages": 2}, {"type": "filter", "filter": "peak", "freq": 1150, "q": 7, "gain": 9}, {"type": "filter", "filter": "peak", "freq": 2300, "q": 9, "gain": 5}, {"type": "echo", "time": 0.011, "feedback": 0.5, "mix": 0.25, "damp": 3000}]},
    "crab/snip": {"about": "Helmet Crab snip: two quick claw clicks, a pause, two more; a grain of sand under them.", "params": {"freq": 1750}, "length": 0.45, "tail": 0.3, "layers": [{"type": "patch", "patch": "creature/clack", "length": 0.5, "params": {"freq": "$freq", "count": 2, "gap": 0.045, "decay": 0.8}}, {"type": "patch", "patch": "creature/clack", "start": 0.27, "length": 0.5, "gain": -2, "params": {"freq": "$freq*1.06", "count": 2, "gap": 0.04, "decay": 0.8}}, {"type": "patch", "patch": "object/rustle", "length": 0.6, "gain": -18, "params": {"len": 0.4, "density": 90, "f0": 1500, "f1": 5000}}]},
    "crab/hurt": {"about": "Helmet Crab hurt: a falling squeak and a shell knock.", "params": {"pitch": 1400}, "length": 0.2, "tail": 0.3, "layers": [{"type": "patch", "patch": "creature/squeak", "length": 0.4, "params": {"pitch": "$pitch", "len": 0.12, "bend": -4}}, {"type": "patch", "patch": "creature/clack", "length": 0.4, "gain": -7, "params": {"freq": "$pitch*1.4", "count": 1, "decay": 0.6}}]},
    "crab/step": {"about": "Helmet Crab step: a tiny leg click on a soft footfall.", "params": {"freq": 2200}, "length": 0.1, "tail": 0.25, "layers": [{"type": "patch", "patch": "creature/clack", "length": 0.3, "params": {"freq": "$freq", "count": 1, "decay": 0.5}}, {"type": "patch", "patch": "impact/step", "length": 0.3, "gain": -9, "params": {"weight": 0.3, "bright": 1.4, "len": 0.05}}]},
    "pedestal/accept": {"about": "Trophy pedestal: a rasping snarl over a stone thunk, a faint ring after.", "params": {"pitch": 120}, "length": 1.1, "tail": 0.5, "layers": [{"type": "patch", "patch": "creature/growl", "length": 1.5, "params": {"pitch": "$pitch", "len": 1.0, "size": 0.85, "rough": 4, "rasp": 0.6, "wobble": 1, "vowelA": 0, "vowelB": 3}}, {"type": "patch", "patch": "impact/knock_stone", "length": 1.0, "gain": -5, "params": {"freq": 280, "decay": 1.3}}, {"type": "patch", "patch": "magic/shimmer", "start": 0.35, "length": 1.2, "gain": -16, "params": {"freq": 440, "len": 0.7, "sparkle": 0.2}}]}
  },
