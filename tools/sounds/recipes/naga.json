    "mob/naga/hurt2": {"patch": "naga/hurt", "params": {"pitch": 160}, "seed": 2012},
    "mob/naga/hurt3": {"patch": "naga/hurt", "params": {"pitch": 170}, "seed": 2013},
    "mob/naga/rattle1": {"patch": "naga/rattle", "params": {"len": 0.75, "rate": 27}, "seed": 2021},
    "mob/naga/rattle2": {"patch": "naga/rattle", "params": {"len": 0.85, "rate": 30}, "seed": 2022}
