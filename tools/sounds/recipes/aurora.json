{
  "about": "U28 aurora: refinements of the baseline (tools/sounds/baseline/aurora.json). Original sound designs; upstream's audio is never read. The events (ids, subtitles, categories, volumes, pitches, variant counts) stay upstream's; as in upstream the ice cores, the Snow Guardian and the Snow Queen share the ice files. The ice crackles: sparse frosty clicks and icy pings over a faint cold glimmer; a hit is a pair of hard ice knocks with a splintering crackle; a death is a shatter: a crunch of breaking ice, a spray of falling shards and a fading glassy ring.",
  "patches": {
    "ice/crackle": {
      "about": "Ice crackle: frosty clicks and pings over a faint glimmer.",
      "params": {"len": 0.8, "density": 30},
      "length": "$len", "tail": 0.5,
      "layers": [
        {"type": "patch", "patch": "ambient/crackle", "length": "$len+0.4", "params": {"len": "$len", "density": "$density", "ping": 0.75}},
        {"type": "patch", "patch": "magic/shimmer", "length": "$len+0.8", "gain": -17, "params": {"freq": 1760, "len": "$len*0.8", "sparkle": 0.6}}
      ]
    },
    "ice/hurt": {
      "about": "Ice hit: two hard ice knocks and a splintering crackle.",
      "params": {"freq": 2450},
      "length": 0.3, "tail": 0.6,
      "layers": [
        {"type": "patch", "patch": "impact/knock_ice", "length": 0.8, "params": {"freq": "$freq", "count": 2, "gap": 0.045, "decay": 0.8, "spread": 0.2}},
        {"type": "patch", "patch": "ambient/crackle", "length": 0.6, "gain": -10, "params": {"len": 0.25, "density": 45, "ping": 0.4}}
      ]
    },
    "ice/shatter": {
      "about": "Ice shatter: a crunch of breaking ice, a spray of shards and a fading glassy ring.",
      "params": {"freq": 2350},
      "length": 0.7, "tail": 1.0,
      "layers": [
        {"type": "patch", "patch": "impact/crunch", "length": 0.9, "params": {"len": 0.6, "freq": "$freq", "bright": 1.5}},
        {"type": "patch", "patch": "impact/knock_ice", "start": 0.08, "length": 1.4, "gain": -4, "params": {"freq": "$freq*1.1", "count": 7, "gap": 0.035, "decay": 0.6, "spread": 0.7}},
        {"type": "patch", "patch": "magic/shimmer", "start": 0.15, "length": 1.6, "gain": -14, "params": {"freq": 1320, "len": 0.8, "sparkle": 0.5}}
      ]
    }
  },
  "files": {
    "mob/ice/crackle1": {"patch": "ice/crackle", "params": {"len": 0.75, "density": 28}, "seed": 2801},
    "mob/ice/crackle2": {"patch": "ice/crackle", "params": {"len": 0.85, "density": 34}, "seed": 2802},
    "mob/ice/death1": {"patch": "ice/shatter", "params": {"freq": 2250}, "seed": 2811},
    "mob/ice/death2": {"patch": "ice/shatter", "params": {"freq": 2450}, "seed": 2812},
    "mob/ice/hurt1": {"patch": "ice/hurt", "params": {"freq": 2380}, "seed": 2821},
    "mob/ice/hurt2": {"patch": "ice/hurt", "params": {"freq": 2560}, "seed": 2822}
  }
}
