{
  "about": "U17 hostiles: refinements of the baseline (tools/sounds/baseline/hostiles.json). Original sound designs; upstream's audio is never read. The events (ids, subtitles, categories, volumes, pitches, variant counts) stay upstream's; as in upstream the hostile, mist and winter wolves share one set of wolf files and the Wraith's ambient, hurt and death share its four gasps. The Fire Beetle chitters with a smouldering crackle under its buzz; the Pinch Beetle's buzz carries pincer clicks and its attack is a hard double snap with a thump; the Slime Beetle chitters wetly. The Redcap chuckles in short breathy 'heh' syllables, screeches when hurt and groans long when it dies. The wolves growl low and wet, yelp when hurt and snarl (a growl over a hiss) when they take notice. The Wraith gasps: a sharp whispered inhale and a falling ghostly moan in a large room.",
  "patches": {
    "fire_beetle/voice": {
      "about": "Fire Beetle: an insect buzz over smouldering crackles.",
      "params": {"pitch": 140, "len": 0.6, "bend": 0, "band": 900, "wing": 45, "fire": -13},
      "length": "$len", "tail": 0.25,
      "layers": [
        {"type": "patch", "patch": "creature/insect", "length": "$len+0.2", "params": {"pitch": "$pitch", "len": "$len", "wing": "$wing", "band": "$band", "q": 1.3, "bend": "$bend"}},
        {"type": "patch", "patch": "ambient/crackle", "length": "$len+0.3", "gain": "$fire", "params": {"len": "$len", "density": 22, "ping": 0.1}}
      ]
    },
    "pinch_beetle/voice": {
      "about": "Pinch Beetle: a buzz with pincer clicks.",
      "params": {"pitch": 180, "len": 0.5, "bend": 0, "clicks": 2},
      "length": "$len", "tail": 0.2,
      "layers": [
        {"type": "patch", "patch": "creature/insect", "length": "$len+0.2", "params": {"pitch": "$pitch", "len": "$len", "wing": 60, "band": 1500, "bend": "$bend"}},
        {"type": "patch", "patch": "creature/clack", "start": "$len*0.2", "length": 0.6, "gain": -8, "params": {"freq": 1300, "count": "$clicks", "gap": 0.06, "decay": 0.7}}
      ]
    },
    "pinch_beetle/snap": {
      "about": "Pinch Beetle clamp: a hard double snap of chitin with a body thump.",
      "params": {"freq": 1200},
      "length": 0.25, "tail": 0.4,
      "layers": [
        {"type": "patch", "patch": "creature/clack", "length": 0.6, "params": {"freq": "$freq", "count": 2, "gap": 0.04, "decay": 1.4}},
        {"type": "patch", "patch": "impact/thud", "length": 0.6, "gain": -7, "params": {"pitch": 150, "len": 0.14, "crack": 0.8}}
      ]
    },
    "slime_beetle/voice": {
      "about": "Slime Beetle: a wet blorp with a muffled buzz.",
      "params": {"pitch": 140, "len": 0.35, "wet": 0.75, "bend": 0},
      "length": "$len", "tail": 0.25,
      "layers": [
        {"type": "patch", "patch": "creature/squish", "length": "$len+0.3", "params": {"pitch": "$pitch", "len": "$len", "wet": "$wet"}},
        {"type": "patch", "patch": "creature/insect", "length": "$len+0.2", "gain": -9, "params": {"pitch": "$pitch*1.1", "len": "$len*0.9", "wing": 50, "band": 800, "bend": "$bend"}}
      ]
    },
    "redcap/chuckle": {
      "about": "Goblin chuckle: short breathy 'heh' syllables falling in pitch.",
      "params": {"pitch": 260, "count": 5, "syll": 0.085, "size": 1.35, "rough": 2.0},
      "length": "$count*$syll*1.3", "tail": 0.2,
      "layers": [
        {"type": "osc", "wave": "saw", "length": "$syll", "freq": {"env": [[0, "$pitch*semi(rand(1,4))"], ["$syll", "$pitch*semi(rand(-3,0))"]], "curve": "exp"}, "env": {"a": 0.006, "d": "$syll*0.6", "s": 0.4, "r": 0.03}, "formant": {"vowel": "rand(0.7,1.4)", "shift": "$size", "mix": 0.85}, "drive": "$rough", "repeat": {"count": "$count", "every": "$syll*1.3", "jitter": 0, "decay": 0.88}},
        {"type": "noise", "color": "pink", "amp": 0.3, "length": "$syll*0.7", "env": {"a": 0.004, "d": "$syll*0.5", "s": 0.1, "r": 0.02}, "filter": [{"type": "bp", "freq": "2200*$size", "q": 1.2}], "repeat": {"count": "$count", "every": "$syll*1.3", "jitter": 0, "decay": 0.88}}
      ],
      "fx": [{"type": "filter", "filter": "hp", "freq": 140}, {"type": "filter", "filter": "lp", "freq": "5200*$size", "stages": 2}, {"type": "reverb", "room": 0.2, "mix": 0.06}]
    },
    "wolf/snarl": {
      "about": "Wolf taking notice: a rough rising growl over a bared-teeth hiss.",
      "params": {"pitch": 115, "len": 1.2},
      "length": "$len", "tail": 0.3,
      "layers": [
        {"type": "patch", "patch": "creature/growl", "length": "$len+0.3", "params": {"pitch": "$pitch", "len": "$len", "size": 0.95, "rough": 5, "rasp": 0.6, "wobble": 1.0, "vowelA": 2, "vowelB": 4, "rumble": 34}},
        {"type": "patch", "patch": "creature/hiss", "length": "$len", "gain": -13, "params": {"len": "$len*0.6", "bright": 0.7, "attack": 0.1}}
      ]
    },
    "wraith/gasp": {
      "about": "Wraith gasp: a sharp whispered inhale, then a falling ghostly moan in a large room.",
      "params": {"pitch": 200, "len": 1.3, "glide": -6},
      "length": "$len+0.3", "tail": 0.6,
      "layers": [
        {"type": "noise", "color": "white", "length": 0.32, "env": {"env": [[0, 0], [0.26, 1], [0.32, 0]], "curve": "smooth"}, "filter": [{"type": "bp", "freq": {"from": 1400, "to": 3200, "time": 0.3}, "q": 1.6}], "gain": -3},
        {"type": "patch", "patch": "creature/ghost", "start": 0.28, "length": "$len+1.2", "params": {"pitch": "$pitch", "len": "$len", "glide": "$glide", "whisper": 0.5, "room": 0.85, "vowelA": 0, "vowelB": 4}}
      ]
    }
  },
