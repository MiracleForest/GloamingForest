    "rp/entity/unstable_ice_core.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:unstable_ice_core",
          "materials": {
            "default": "entity_alphatest"
          },
