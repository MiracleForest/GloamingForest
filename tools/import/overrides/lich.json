{
  "patch": {
    "rp/entity/death_tome.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:death_tome",
          "materials": {
            "default": "entity_alphatest"
          },
          "textures": {
            "default": "textures/entity/enchanting_table_book"
          },
          "geometry": {
            "default": "geometry.twilightforest.death_tome"
          },
          "scripts": {
            "animate": [
              {
                "base": "!variable.on_lectern"
              },
              {
                "lectern": "variable.on_lectern"
              },
              "flip"
            ],
            "pre_animation": [
              "variable.on_lectern = query.property('gf:on_lectern');",
              "variable.dt = math.min(query.delta_time * 20, 4);",
              "variable.flip_t = variable.flip_t ?? 0; variable.flip = variable.flip ?? 0; variable.flip_a = variable.flip_a ?? 0;",
              "variable.turn = math.random_integer(0, 3) - math.random_integer(0, 3); variable.turn = variable.turn == 0 ? (math.random(0, 1) < 0.5 ? 1 : -1) : variable.turn;",
              "variable.flip_t = math.random(0, 1) < variable.dt / (variable.on_lectern ? 120 : 30) ? variable.flip_t + variable.turn : variable.flip_t;",
              "variable.flip_f = math.clamp((variable.flip_t - variable.flip) * 0.4, -0.2, 0.2);",
              "variable.flip_a = variable.flip_a + (variable.flip_f - variable.flip_a) * math.min(0.9 * variable.dt, 1);",
              "variable.flip = variable.flip + variable.flip_a * variable.dt;",
              "variable.flip_right = math.clamp((variable.flip + 0.25 - math.floor(variable.flip + 0.25)) * 1.6 - 0.3, 0, 1);",
              "variable.flip_left = math.clamp((variable.flip + 0.75 - math.floor(variable.flip + 0.75)) * 1.6 - 0.3, 0, 1);",
              "variable.open_angle = variable.on_lectern ? 1.5 : (math.sin(query.life_time * 20 * 0.4 * 57.2958) * 0.3 + 1.25) * 0.9;"
            ]
          },
          "animations": {
            "base": "animation.twilightforest.death_tome.base",
            "lectern": "animation.twilightforest.death_tome.lectern",
            "flip": "animation.twilightforest.death_tome.flip"
          },
          "render_controllers": [
            "controller.render.twilightforest.death_tome"
          ],
          "spawn_egg": {
            "base_color": "#774e22",
            "overlay_color": "#dbcdbe"
          }
        }
      }
    ],
    "rp/entity/lich_bolt.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:lich_bolt",
          "materials": {
            "default": "snowball"
          },
          "textures": {
            "default": "textures/twilightforest/particle/twilight_orb"
          },
          "geometry": {
            "default": "geometry.item_sprite"
          },
          "render_controllers": [
            "controller.render.item_sprite"
          ],
          "animations": {
            "flying": "animation.actor.billboard"
          },
          "scripts": {
            "animate": [
              "flying"
            ]
          }
        }
      }
    ],
    "rp/entity/lich_bomb.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:lich_bomb",
          "materials": {
            "default": "snowball"
          },
          "textures": {
            "default": "textures/items/magma_cream"
          },
          "geometry": {
            "default": "geometry.item_sprite"
          },
          "render_controllers": [
            "controller.render.item_sprite"
          ],
          "animations": {
            "flying": "animation.actor.billboard"
          },
          "scripts": {
            "pre_animation": [
              "variable.f = (math.sin(query.life_time * 20 * 57.2958) + 1) * 0.5;",
              "variable.f1 = 1 + math.sin(variable.f * 100 * 57.2958) * variable.f * 0.01;",
              "variable.g = math.pow(math.clamp(variable.f, 0, 1), 4);"
            ],
            "scaleX": "(1 + variable.g * 0.4) * variable.f1",
            "scaleY": "(1 + variable.g * 0.1) / variable.f1",
            "scaleZ": "(1 + variable.g * 0.4) * variable.f1",
            "animate": [
              "flying"
            ]
          }
        }
      }
    ],
    "rp/entity/lich_minion.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:lich_minion",
          "materials": {
            "default": "zombie",
            "tinted": "entity_alphatest_change_color"
          },
          "textures": {
            "default": "textures/entity/zombie/zombie"
          },
          "geometry": {
            "default": "geometry.twilightforest.lich_minion"
          },
          "scripts": {
            "initialize": [
              "variable.gliding_speed_value = 1.0;"
            ],
            "pre_animation": [
              "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
            ],
            "animate": [
              "humanoid_base_pose",
              "look_at_target",
              "move",
              "attack_bare_hand",
              "bob",
              "base"
            ]
          },
          "animations": {
            "humanoid_base_pose": "animation.humanoid.base_pose",
            "look_at_target": "animation.humanoid.look_at_target.default",
            "move": "animation.humanoid.move",
            "attack_bare_hand": "animation.zombie.attack_bare_hand",
            "bob": "animation.humanoid.bob",
            "base": "animation.twilightforest.lich_minion.base"
          },
          "render_controllers": [
            "controller.render.twilightforest.lich_minion"
          ],
          "enable_attachables": true
        }
      }
    ],
    "rp/entity/lich.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:lich",
          "materials": {
            "default": "entity_alphatest",
            "clone": "entity_alphablend",
            "eyes": "entity_emissive_alpha"
          },
          "textures": {
            "default": "textures/twilightforest/entity/twilightlich64",
            "clone": "textures/twilightforest/lich/tf-derived/twilightlich64_clone",
            "eyes": "textures/twilightforest/entity/twilightlich64_eyes"
          },
          "geometry": {
            "default": "geometry.twilightforest.lich"
          },
          "scripts": {
            "scale": "1.125",
            "pre_animation": [
              "variable.death_time = query.property('twilightforest:death_time');",
              "variable.dying = variable.death_time > 0;",
              "variable.phase = query.property('twilightforest:phase');",
              "variable.has_item = query.is_item_equipped(0);",
              "variable.limb = query.modified_move_speed * 0.75;"
            ],
            "animate": [
              "base_pose",
              "look_at_target",
              "legs",
              "arms",
              "death",
              "shake"
            ]
          },
          "animations": {
            "base_pose": "animation.humanoid.base_pose",
            "look_at_target": "animation.humanoid.look_at_target.default",
            "legs": "animation.twilightforest.lich.legs",
            "arms": "animation.twilightforest.lich.arms",
            "death": "animation.twilightforest.lich.death",
            "shake": "animation.twilightforest.lich.shake"
          },
          "render_controllers": [
            {
              "controller.render.twilightforest.lich": "!query.property('twilightforest:clone')"
            },
            {
              "controller.render.twilightforest.lich_clone": "query.property('twilightforest:clone')"
            },
            {
              "controller.render.twilightforest.lich_clone_eyes": "query.property('twilightforest:clone')"
            }
          ],
          "enable_attachables": true,
          "spawn_egg": {
            "base_color": "#aca489",
            "overlay_color": "#360472"
          }
        }
      }
    ],
    "rp/entity/rising_zombie.entity.json": [
      {
        "op": "replace",
        "path": "/minecraft:client_entity/description",
        "value": {
          "identifier": "twilightforest:rising_zombie",
          "materials": {
            "default": "zombie"
          },
          "textures": {
            "default": "textures/entity/zombie/zombie"
          },
          "geometry": {
            "default": "geometry.twilightforest.rising_zombie"
          },
          "scripts": {
            "pre_animation": [
              "variable.rise_t = query.property('twilightforest:rising_ticks');",
              "variable.rise_a = (80 - math.min(80, variable.rise_t)) / 80;",
              "variable.rise_b = (40 - math.min(40, math.max(0, variable.rise_t - 80))) / 40;",
              "variable.rise_angle = 120 * variable.rise_a - 30 * variable.rise_b;",
              "variable.rise_drop = 16 * (variable.rise_a + variable.rise_b);"
            ],
            "animate": [
              "humanoid_base_pose",
              "zombie_arms",
              "base",
              "rise"
            ]
          },
          "animations": {
            "humanoid_base_pose": "animation.humanoid.base_pose",
            "zombie_arms": "animation.zombie.attack_bare_hand",
            "base": "animation.twilightforest.rising_zombie.base",
            "rise": "animation.twilightforest.rising_zombie.rise"
          },
          "render_controllers": [
            "controller.render.twilightforest.rising_zombie"
          ]
        }
      }
    ],
