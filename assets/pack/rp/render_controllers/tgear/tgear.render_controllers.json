{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.twilightforest.tgear_gloves": {
      "geometry": "c.owning_entity->v.tgear_gloves > 1.5 ? Geometry.gloves_slim : Geometry.gloves",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.twilightforest.tgear_belt": {
      "geometry": "Geometry.belt",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.twilightforest.tgear_goggles": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "c.owning_entity->v.tgear_zoom > 0 ? Texture.down : Texture.default"
      ]
    }
  }
}
