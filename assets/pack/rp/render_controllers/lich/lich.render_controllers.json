{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.gloamingforest.lich": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "variable.death_time <= 115"
        },
        {
          "hat": true
        }
      ]
    },
    "controller.render.gloamingforest.lich_clone": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.clone"
        }
      ],
      "textures": [
        "Texture.clone"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "cloak": false
        },
        {
          "collar": false
        }
      ]
    },
    "controller.render.gloamingforest.lich_clone_eyes": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.eyes"
        }
      ],
      "textures": [
        "Texture.eyes"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {
          "*": true
        },
        {
          "cloak": false
        },
        {
          "collar": false
        }
      ]
    },
    "controller.render.gloamingforest.death_tome": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "loose_page_*": "!query.property('gf:on_lectern')"
        }
      ]
    },
    "controller.render.gloamingforest.rising_zombie": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "rightLeg": "query.property('gloamingforest:rising_ticks') > 40"
        },
        {
          "leftLeg": "query.property('gloamingforest:rising_ticks') > 40"
        }
      ]
    },
    "controller.render.gloamingforest.lich_minion": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "0.0",
        "g": "0.5",
        "b": "0.0",
        "a": "query.property('gloamingforest:strong') ? 0.75 : 0.5"
      }
    }
  }
}
