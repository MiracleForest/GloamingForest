{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.twilightforest.armory.overlay": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.overlay"
        }
      ],
      "textures": [
        "Texture.overlay"
      ]
    },
    "controller.render.twilightforest.armory.fullbright": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "ignore_lighting": true
    }
  }
}
