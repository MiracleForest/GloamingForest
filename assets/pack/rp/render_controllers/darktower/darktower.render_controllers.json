{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.gloamingforest.ur_ghast": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.openeyes",
            "Texture.fire"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[(q.property('gloamingforest:charging') || q.property('gloamingforest:death_time') > 0 || q.property('gloamingforest:attack_status') == 2) ? 2 : (q.property('gloamingforest:attack_status') == 1 ? 1 : 0)]"
      ],
      "is_hurt_color": {
        "r": 1.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.5
      },
      "on_fire_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "part_visibility": [
        {
          "*": "q.property('gloamingforest:death_time') <= 30"
        }
      ]
    },
    "controller.render.gloamingforest.carminite_ghast": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.openeyes",
            "Texture.fire"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[(q.property('gloamingforest:charging') || !q.is_alive || q.property('gloamingforest:attack_status') == 2) ? 2 : (q.property('gloamingforest:attack_status') == 1 ? 1 : 0)]"
      ]
    }
  }
}
