{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.gloamingforest.knight_phantom.charging": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "charging": "q.property('gloamingforest:charging') && q.property('gloamingforest:dying_visible')"
            }
          ]
        },
        "charging": {
          "particle_effects": [
            {
              "effect": "smoke"
            }
          ],
          "transitions": [
            {
              "default": "!q.property('gloamingforest:charging') || !q.property('gloamingforest:dying_visible')"
            }
          ]
        }
      }
    }
  }
}
