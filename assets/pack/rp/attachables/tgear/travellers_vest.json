{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "twilightforest:travellers_vest",
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/twilightforest/models/armor/travellers_layer_1",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.twilightforest.travellers_armor.vest",
        "gloves": "geometry.twilightforest.travellers_armor.gloves",
        "gloves_slim": "geometry.twilightforest.travellers_armor.gloves_slim"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;"
      },
      "render_controllers": [
        "controller.render.armor",
        {
          "controller.render.twilightforest.tgear_gloves": "c.owning_entity->v.tgear_gloves > 0 && (!c.is_first_person || c.owning_entity->v.tgear_glove_overlay > 0)"
        }
      ]
    }
  }
}
