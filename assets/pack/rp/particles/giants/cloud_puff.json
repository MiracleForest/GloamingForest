{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gloamingforest:cloud_puff",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.vx = v.velocity.x * 20; v.vy = v.velocity.y * 20; v.vz = v.velocity.z * 20;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.vx + math.random(-0.4, 0.4) * 0.2",
          "v.vy + math.random(-0.4, 0.4) * 0.2",
          "v.vz + math.random(-0.4, 0.4) * 0.2"
        ]
      },
      "minecraft:particle_initialization": {
        "per_particle_expression": "v.grey = 1 - math.random(0, 0.3); v.size = 0.0875 * (0.5 + math.random(0, 0.5)) * 2;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.max(math.floor(8 / (math.random(0, 0.8) + 0.3)) * 2.5, 1) / 20"
      },
      "minecraft:particle_initial_speed": "math.sqrt(v.vx * v.vx + v.vy * v.vy + v.vz * v.vz) + 0.4",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.8164
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size * math.clamp(v.particle_age / v.particle_lifetime * 32, 0, 1)",
          "v.size * math.clamp(v.particle_age / v.particle_lifetime * 32, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.grey",
          "v.grey",
          "v.grey",
          1.0
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
