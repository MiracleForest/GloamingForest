{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gloamingforest:perfect_dodge",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.vx = v.velocity.x; v.vy = v.velocity.y; v.vz = v.velocity.z;"
      },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "v.f = v.particle_age / v.particle_lifetime; v.size = 0.1 * (v.particle_random_1 * 0.2 + 0.5) * (1 - math.pow(1 - v.f, 2));"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 * (1 + v.particle_random_2 / 1.5)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.vx * (1 + v.particle_age / v.particle_lifetime - 2 * math.pow(v.particle_age / v.particle_lifetime, 2))",
          "v.vy * (1 + v.particle_age / v.particle_lifetime - 2 * math.pow(v.particle_age / v.particle_lifetime, 2))",
          "v.vz * (1 + v.particle_age / v.particle_lifetime - 2 * math.pow(v.particle_age / v.particle_lifetime, 2))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["v.size", "v.size"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": ["math.floor(v.particle_random_3 * 8) * 8", 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 * 0.6 + 0.4) * 0.9",
          "(v.particle_random_4 * 0.6 + 0.4) * 0.3",
          "v.particle_random_4 * 0.6 + 0.4",
          1.0
        ]
      }
    }
  }
}
