{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gf:portal",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(math.floor(math.random(0, 10)) + 40) / 20"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.direction.x * (1 - (2 * math.pow(variable.particle_age / variable.particle_lifetime, 2) - variable.particle_age / variable.particle_lifetime))",
          "variable.direction.y * (1 - (2 * math.pow(variable.particle_age / variable.particle_lifetime, 2) - variable.particle_age / variable.particle_lifetime)) + 1 - variable.particle_age / variable.particle_lifetime",
          "variable.direction.z * (1 - (2 * math.pow(variable.particle_age / variable.particle_lifetime, 2) - variable.particle_age / variable.particle_lifetime))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.1 * (variable.particle_random_1 * 0.2 + 0.5)) * (1 - math.pow(1 - variable.particle_age / variable.particle_lifetime, 2))",
          "(0.1 * (variable.particle_random_1 * 0.2 + 0.5)) * (1 - math.pow(1 - variable.particle_age / variable.particle_lifetime, 2))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "8 * math.floor(variable.particle_random_3 * 8)",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.particle_random_2 * 0.6 + 0.4) * 0.9",
          "(variable.particle_random_2 * 0.6 + 0.4) * 0.3",
          "variable.particle_random_2 * 0.6 + 0.4",
          1.0
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
