{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gf:dust",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.direction.x / math.max(math.sqrt(variable.direction.x * variable.direction.x + variable.direction.y * variable.direction.y + variable.direction.z * variable.direction.z), 0.000001)",
          "variable.direction.y / math.max(math.sqrt(variable.direction.x * variable.direction.x + variable.direction.y * variable.direction.y + variable.direction.z * variable.direction.z), 0.000001)",
          "variable.direction.z / math.max(math.sqrt(variable.direction.x * variable.direction.x + variable.direction.y * variable.direction.y + variable.direction.z * variable.direction.z), 0.000001)"
        ]
      },
      "minecraft:particle_initial_speed": "math.sqrt(variable.direction.x * variable.direction.x + variable.direction.y * variable.direction.y + variable.direction.z * variable.direction.z) * 20",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.dust_ticks / 20"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.8164
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.1,
        "coefficient_of_restitution": 0,
        "collision_drag": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.dust_size * math.clamp(variable.particle_age / variable.particle_lifetime * 32, 0, 1)",
          "variable.dust_size * math.clamp(variable.particle_age / variable.particle_lifetime * 32, 0, 1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "56 - 8 * math.floor(math.floor(variable.particle_age * 20) * 7 / variable.dust_ticks)",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.particle_random_2 * 0.2 + 0.8) * variable.color.r * (variable.particle_random_1 * 0.4 + 0.6)",
          "(variable.particle_random_3 * 0.2 + 0.8) * variable.color.g * (variable.particle_random_1 * 0.4 + 0.6)",
          "(variable.particle_random_4 * 0.2 + 0.8) * variable.color.b * (variable.particle_random_1 * 0.4 + 0.6)",
          1.0
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
