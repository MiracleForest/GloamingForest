{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "twilightforest:ghast_trap",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.size = (0.1 * (variable.particle_random_3 * 0.5 + 0.5) * 2.0) * 0.75 * 3.0;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.floor(10.0 / (variable.particle_random_1 * 0.8 + 0.2)) / 20.0"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.velocity.x * (1.0 - variable.particle_age / variable.particle_lifetime)",
          "variable.velocity.y * (1.0 - variable.particle_age / variable.particle_lifetime)",
          "variable.velocity.z * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.1 * (variable.particle_random_3 * 0.5 + 0.5) * 2.0) * 2.25 * math.clamp(variable.particle_age / variable.particle_lifetime * 32.0, 0.0, 1.0)",
          "(0.1 * (variable.particle_random_3 * 0.5 + 0.5) * 2.0) * 2.25 * math.clamp(variable.particle_age / variable.particle_lifetime * 32.0, 0.0, 1.0)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          "(variable.particle_random_2 * 0.2 + 0.8) * (variable.particle_random_4 * 0.4)",
          "(variable.particle_random_2 * 0.2 + 0.8) * (variable.particle_random_4 * 0.4)",
          1.0
        ]
      }
    }
  }
}
