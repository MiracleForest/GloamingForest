{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gloamingforest:magic_effect",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.red = (variable.velocity.y < 0); variable.shade = math.random(0.5, 1.0);"
      },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.4 / (math.random(0, 1) * 0.8 + 0.2)"
      },
      "minecraft:particle_initial_speed": [
        "math.random(-0.4, 0.4) * 0.1 * 20",
        "(0.1 + math.random(-0.06, 0.06)) * 0.2 * 20",
        "math.random(-0.4, 0.4) * 0.1 * 20"
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 1.6, 0],
        "linear_drag_coefficient": 0.8164
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.1 * (variable.particle_random_1 * 0.5 + 0.5) * 2 * 0.75", "0.1 * (variable.particle_random_1 * 0.5 + 0.5) * 2 * 0.75"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 64],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.red ? 1.0 : 0.17 * variable.shade",
          "variable.red ? 0.5 : 0.80 * variable.shade",
          "variable.red ? 0.5 : 0.69 * variable.shade",
          1.0
        ]
      }
    }
  }
}
