{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gloamingforest:particle_spawner_firefly",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/gloamingforest/particle/firefly"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_point": {
        "direction": ["(math.random(-0.4, 0.4) * 0.3 + math.random(0, 1) * (math.random(0, 1) > 0.5 ? -3.9 : 3.9) * math.random(0, 1) * 0.1) * 20", "((math.random(-0.4, 0.4) * 0.3 + 0.1) * 0.1 + math.random(0, 1) * -0.25 * math.random(0, 1) * 0.1) * 20", "(math.random(-0.4, 0.4) * 0.3 + math.random(0, 1) * (math.random(0, 1) > 0.5 ? -3.9 : 3.9) * math.random(0, 1) * 0.1) * 20"]
      },
      "minecraft:particle_initial_speed": 1,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(30 + math.floor(variable.particle_random_1 * 21)) / 20"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.404
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.2 + variable.particle_random_2 * 0.1", "0.2 + variable.particle_random_2 * 0.1"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.5 + variable.particle_random_3 * 0.25",
          "0.85 - variable.particle_random_4 * 0.25",
          0,
          "math.clamp(1 - math.abs(2 * variable.particle_age / variable.particle_lifetime - 1), 0, 1)"
        ]
      }
    }
  }
}
