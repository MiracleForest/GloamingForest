          "v.qr_b6 = math.mod(math.floor(v.qr_flags / 64), 2);",
          "v.qr_b7 = math.mod(math.floor(v.qr_flags / 128), 2);",
          "v.qr_b8 = math.mod(math.floor(v.qr_flags / 256), 2);",
