{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gloamingforest:upper_goblin_knight",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/gloamingforest/entity/doublegoblin"
      },
      "geometry": {
        "default": "geometry.gloamingforest.upper_goblin_knight.rooted"
      },
      "render_controllers": [
        "controller.render.gloamingforest.upper_goblin_knight"
      ],
      "animations": {
        "base": "animation.gloamingforest.upper_goblin_knight.base",
        "spear": "animation.gloamingforest.upper_goblin_knight.spear",
        "unshielded": "animation.gloamingforest.upper_goblin_knight.unshielded",
        "shield_disabled": "animation.gloamingforest.upper_goblin_knight.shield_disabled"
      },
      "scripts": {
        "animate": [
          "base",
          {
            "spear": "q.property('gloamingforest:spear_timer') > 0"
          },
          {
            "unshielded": "!q.property('gloamingforest:shield')"
          },
          {
            "shield_disabled": "q.property('gloamingforest:shield_disabled')"
          }
        ],
        "pre_animation": [
          "v.t = 60.0 - q.property('gloamingforest:spear_timer');"
        ]
      }
    }
  }
}
