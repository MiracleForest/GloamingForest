{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "twilightforest:loyal_zombie",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/zombie/zombie" },
      "geometry": { "default": "geometry.zombie.v1.8" },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "initialize": ["variable.gliding_speed_value = 1.0;"],
        "animate": ["humanoid_base_pose", "look_at_target", "move", "attack", "bob"]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack": "animation.zombie.attack_bare_hand",
        "bob": "animation.humanoid.bob"
      },
      "render_controllers": ["controller.render.twilightforest.loyal_zombie"],
      "enable_attachables": true
    }
  }
}
