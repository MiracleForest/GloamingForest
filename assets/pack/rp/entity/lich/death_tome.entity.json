{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "twilightforest:death_tome",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/enchanting_table_book" },
      "geometry": { "default": "geometry.twilightforest.death_tome" },
      "scripts": {
        "animate": [
          { "base": "!query.property('gf:on_lectern')" },
          { "lectern": "query.property('gf:on_lectern')" }
        ]
      },
      "animations": {
        "base": "animation.twilightforest.death_tome.base",
        "lectern": "animation.twilightforest.death_tome.lectern"
      },
      "render_controllers": ["controller.render.twilightforest.death_tome"],
      "spawn_egg": {
        "base_color": "#774e22",
        "overlay_color": "#dbcdbe"
      }
    }
  }
}
