{
  "format_version": "1.8.0",
  "animations": {
    "animation.gloamingforest.hydra_head.pose": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation - q.property('gloamingforest:mouth') * 15.0",
            "query.target_y_rotation",
            "math.min(math.sqrt(math.max(q.property('gloamingforest:death') - 1.0, 0.0) / 20.0 * 1.6), 1.0) * 90.0"
          ]
        },
        "jaw": {
          "rotation": [
            "q.property('gloamingforest:mouth') * 60.0",
            0,
            0
          ]
        }
      }
    }
  }
}
