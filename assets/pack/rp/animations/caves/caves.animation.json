        "rightArm": {
          "rotation": [
            "(q.property('twilightforest:rock') > 0 ? 180 : math.cos(query.modified_distance_moved * 38.1704 + 180) * query.modified_move_speed * 57.2958) + (variable.attack_time > 0 ? (variable.attack_time - 1) * 180 : 0) + (q.property('twilightforest:rock') > 0 ? 0 : math.sin(query.life_time * 76.7763) * 2.8648)",
            0,
            "q.property('twilightforest:rock') > 0 ? 0 : math.cos(query.life_time * 103.1324) * 2.8648 + 2.8648"
          ]
        },
        "leftArm": {
          "rotation": [
            "(q.property('twilightforest:rock') > 0 ? 180 : math.cos(query.modified_distance_moved * 38.1704) * query.modified_move_speed * 57.2958) + (variable.attack_time > 0 ? (variable.attack_time - 1) * 180 : 0) - (q.property('twilightforest:rock') > 0 ? 0 : math.sin(query.life_time * 76.7763) * 2.8648)",
            0,
            "q.property('twilightforest:rock') > 0 ? 0 : math.cos(query.life_time * 103.1324) * (-2.8648) - 2.8648"
          ]
        }
      }
    },
    "animation.twilightforest.yeti.setup": {
