{
  "format_version": "1.8.0",
  "animations": {
    "animation.twilightforest.troll.setup": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] },
        "hat": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] },
