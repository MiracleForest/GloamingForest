        "leftArm": {
          "rotation": [
            "(q.property('twilightforest:rampaging') ? math.cos(variable.limb_swing * 37.8152) * variable.limb_amount * 57.2958 + 225 : (q.property('twilightforest:tired') ? math.cos(variable.limb_swing * 38.1704) * variable.limb_amount * 57.2958 - 36 : -90 - math.sin(variable.attack_time * 180) * 68.7549 + math.sin((1 - (1 - variable.attack_time) * (1 - variable.attack_time)) * 180) * 22.9183 - math.sin(query.life_time * 76.7763) * 2.8648)) + (query.has_rider ? 180 : 0)",
            "5.7296 - math.sin(variable.attack_time * 180) * 34.3775 - (q.property('twilightforest:rampaging') ? math.cos(variable.limb_swing * 14.3239) * 28.6479 + 28.6479 : 0)",
