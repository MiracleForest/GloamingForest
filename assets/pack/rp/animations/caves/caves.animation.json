            "q.property('twilightforest:angry') ? 5.7296 - math.sin(variable.attack_time * 180) * 34.3775 : 0",
            "q.property('twilightforest:angry') ? 0 : math.cos(query.life_time * 103.1324) * (-2.8648) - 2.8648"
          ]
