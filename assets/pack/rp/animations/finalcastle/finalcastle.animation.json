{
  "format_version": "1.8.0",
  "animations": {
    "animation.twilightforest.adherent.hover": {
      "loop": true,
      "bones": {
        "head": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] },
        "body": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] },
        "rightArm": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] },
        "leftArm": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] },
        "rightLeg": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] },
        "leftLeg": { "position": [0, "2.0 + math.sin(q.life_time * 152.4068) * 1.6", 0] }
      }
    },
    "animation.twilightforest.harbinger_cube.walk": {
      "loop": true,
      "bones": {
        "leg0": { "rotation": ["math.cos(query.modified_distance_moved * 38.1704) * query.modified_move_speed * 80.2141", 0, 0] },
        "leg1": { "rotation": ["math.cos(query.modified_distance_moved * 38.1704 + 180) * query.modified_move_speed * 80.2141", 0, 0] },
        "leg2": { "rotation": ["math.cos(query.modified_distance_moved * 38.1704 + 180) * query.modified_move_speed * 80.2141", 0, 0] },
        "leg3": { "rotation": ["math.cos(query.modified_distance_moved * 38.1704) * query.modified_move_speed * 80.2141", 0, 0] }
      }
    },
    "animation.twilightforest.roving_cube.spin": {
      "loop": true,
      "bones": {
        "box": { "rotation": [0, "-(math.mod(q.life_time * 20.0 + 180.0, 360.0) - 180.0) * 11.0", 0], "scale": 2.0 },
        "box_x": { "rotation": [0, "-(math.mod(q.life_time * 20.0 + 180.0, 360.0) - 180.0) * 11.0", 0], "scale": 2.0 },
        "box_y": { "rotation": [0, "-(math.mod(q.life_time * 20.0 + 180.0, 360.0) - 180.0) * 11.0", 0], "scale": 2.0 },
        "box_z": { "rotation": [0, "-(math.mod(q.life_time * 20.0 + 180.0, 360.0) - 180.0) * 11.0", 0], "scale": 2.0 }
      }
    }
  }
}
