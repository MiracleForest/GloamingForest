{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "twilightforest:death_tome",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "gf:on_lectern": { "type": "bool", "default": false, "client_sync": true }
      }
    },
    "component_groups": {
      "gf:active": {
        "minecraft:behavior.random_fly": { "priority": 5, "xz_dist": 10, "y_dist": 7, "y_offset": 0, "speed_multiplier": 1.0, "can_land_on_trees": false, "avoid_damage_blocks": true },
        "minecraft:behavior.look_at_player": { "priority": 6, "look_distance": 8 },
        "minecraft:behavior.random_look_around": { "priority": 6 },
        "minecraft:behavior.hurt_by_target": { "priority": 1 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [ { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 16 } ]
        }
      },
      "gf:lectern": {
        "minecraft:persistent": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["twilightforest", "death_tome", "monster", "mob"] },
      "minecraft:collision_box": { "width": 0.75, "height": 1.5 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:flying_speed": { "value": 0.6 },
      "minecraft:follow_range": { "value": 16, "max": 16 },
      "minecraft:navigation.fly": { "can_path_over_water": true, "can_path_from_air": true, "can_open_doors": false, "can_pass_doors": true },
      "minecraft:movement.fly": {},
      "minecraft:can_fly": {},
      "minecraft:physics": { "has_gravity": false },
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:damage_sensor": { "triggers": [ { "cause": "fall", "deals_damage": "no" } ] },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 5 : 0" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:environment_sensor": {
        "triggers": [
          { "filters": { "test": "bool_property", "subject": "self", "domain": "gf:on_lectern", "value": true }, "event": "gf:to_lectern" },
          { "filters": { "test": "bool_property", "subject": "self", "domain": "gf:on_lectern", "value": false }, "event": "gf:from_lectern" }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["gf:active"] } },
      "gf:to_lectern": {
        "remove": { "component_groups": ["gf:active"] },
        "add": { "component_groups": ["gf:lectern"] }
      },
      "gf:from_lectern": {
        "remove": { "component_groups": ["gf:lectern"] },
        "add": { "component_groups": ["gf:active"] }
      }
    }
  }
}
