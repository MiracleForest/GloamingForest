{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "twilightforest:creeper_wall_skull_candle",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "twilightforest:candles": [
          0,
          1,
          2,
          3,
          4
        ],
        "twilightforest:facing": [
          "north",
          "south",
          "west",
          "east"
        ],
        "twilightforest:lighting": [
          "none",
          "normal",
          "dim",
          "ominous"
        ]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 5
      },
      "minecraft:geometry": {
        "identifier": "geometry.twilightforest.lichdecor.wall_skull_candle_mob",
        "bone_visibility": {
          "candles_1": "q.block_state('twilightforest:candles') <= 1",
          "candles_2": "q.block_state('twilightforest:candles') == 2",
          "candles_3": "q.block_state('twilightforest:candles') == 3",
          "candles_4": "q.block_state('twilightforest:candles') == 4"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "tf_lichdecor_skull_creeper",
          "render_method": "alpha_test"
        },
        "candle": {
          "texture": "tf_lichdecor_candle",
          "render_method": "alpha_test"
        }
      },
      "minecraft:light_dampening": 0,
      "minecraft:collision_box": {
        "origin": [
          -4,
          4,
          0
        ],
        "size": [
          8,
          8,
          8
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -4,
          4,
          0
        ],
        "size": [
          8,
          8,
          8
        ]
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('twilightforest:facing') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:facing') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:facing') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:facing') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') == 'none'",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "tf_lichdecor_skull_creeper",
              "render_method": "alpha_test"
            },
            "candle": {
              "texture": "tf_lichdecor_candle",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') != 'none'",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "tf_lichdecor_skull_creeper",
              "render_method": "alpha_test"
            },
            "candle": {
              "texture": "tf_lichdecor_candle_lit",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') == 'dim' && q.block_state('twilightforest:candles') == 1",
        "components": {
          "minecraft:light_emission": 1
        }
      },
      {
        "condition": "(q.block_state('twilightforest:lighting') == 'dim' && q.block_state('twilightforest:candles') == 2) || (q.block_state('twilightforest:lighting') == 'ominous' && q.block_state('twilightforest:candles') == 1)",
        "components": {
          "minecraft:light_emission": 2
        }
      },
      {
        "condition": "(q.block_state('twilightforest:lighting') == 'normal' && q.block_state('twilightforest:candles') == 1) || (q.block_state('twilightforest:lighting') == 'dim' && q.block_state('twilightforest:candles') == 3)",
        "components": {
          "minecraft:light_emission": 3
        }
      },
      {
        "condition": "(q.block_state('twilightforest:lighting') == 'dim' && q.block_state('twilightforest:candles') == 4) || (q.block_state('twilightforest:lighting') == 'ominous' && q.block_state('twilightforest:candles') == 2)",
        "components": {
          "minecraft:light_emission": 4
        }
      },
      {
        "condition": "(q.block_state('twilightforest:lighting') == 'normal' && q.block_state('twilightforest:candles') == 2) || (q.block_state('twilightforest:lighting') == 'ominous' && q.block_state('twilightforest:candles') == 3)",
        "components": {
          "minecraft:light_emission": 6
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') == 'ominous' && q.block_state('twilightforest:candles') == 4",
        "components": {
          "minecraft:light_emission": 8
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') == 'normal' && q.block_state('twilightforest:candles') == 3",
        "components": {
          "minecraft:light_emission": 9
        }
      },
      {
        "condition": "q.block_state('twilightforest:lighting') == 'normal' && q.block_state('twilightforest:candles') == 4",
        "components": {
          "minecraft:light_emission": 12
        }
      }
    ]
  }
}
