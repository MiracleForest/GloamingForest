    "entity.gloamingforest.redcap.ambient": {
      "owner": "hostiles",
      "variants": [
        {
          "copy": "alias/hostiles/mob/redcap/redcap1",
          "spec": {
            "patch": {
              "about": "Goblin chuckle: short breathy 'heh' syllables falling in pitch.",
              "params": {
                "pitch": 260,
                "count": 5,
                "syll": 0.085,
                "size": 1.35,
                "rough": 2
              },
              "length": "$count*$syll*1.3",
              "tail": 0.2,
              "layers": [
                {
                  "type": "osc",
                  "wave": "saw",
                  "length": "$syll",
                  "freq": {
                    "env": [
                      [
                        0,
                        "$pitch*semi(rand(1,4))"
                      ],
                      [
                        "$syll",
                        "$pitch*semi(rand(-3,0))"
                      ]
                    ],
                    "curve": "exp"
                  },
                  "env": {
                    "a": 0.006,
                    "d": "$syll*0.6",
                    "s": 0.4,
                    "r": 0.03
                  },
                  "formant": {
                    "vowel": "rand(0.7,1.4)",
                    "shift": "$size",
                    "mix": 0.85
                  },
                  "drive": "$rough",
                  "repeat": {
                    "count": "$count",
                    "every": "$syll*1.3",
                    "jitter": 0,
                    "decay": 0.88
                  }
                },
