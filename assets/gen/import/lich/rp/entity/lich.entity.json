{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "twilightforest:lich",
      "materials": {
        "default": "entity_alphatest",
        "clone": "entity_alphablend",
        "eyes": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/twilightforest/entity/twilightlich64",
        "clone": "textures/twilightforest/lich/tf-derived/twilightlich64_clone",
        "eyes": "textures/twilightforest/entity/twilightlich64_eyes"
      },
      "geometry": {
        "default": "geometry.twilightforest.lich"
      },
      "scripts": {
        "scale": "1.125",
        "pre_animation": [
          "variable.death_time = query.property('twilightforest:death_time');",
          "variable.limb = query.modified_move_speed * 0.75;"
        ],
        "animate": ["base_pose", "look_at_target", "legs", "base", "death"]
      },
      "animations": {
        "base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "legs": "animation.twilightforest.lich.legs",
        "base": "animation.twilightforest.lich.base",
        "death": "animation.twilightforest.lich.death"
      },
      "render_controllers": [
        {
          "controller.render.twilightforest.lich": "!query.property('twilightforest:clone')"
        },
        {
          "controller.render.twilightforest.lich_clone": "query.property('twilightforest:clone')"
        },
        {
          "controller.render.twilightforest.lich_clone_eyes": "query.property('twilightforest:clone')"
        }
      ],
      "enable_attachables": true,
      "spawn_egg": {
        "base_color": "#aca489",
        "overlay_color": "#360472"
      }
    }
  }
}
