{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gloamingforest:lich",
      "materials": {
        "default": "entity_alphatest",
        "clone": "entity_alphablend",
        "eyes": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/gloamingforest/entity/gloaminglich64",
        "clone": "textures/gloamingforest/lich/upstream-derived/gloaminglich64_clone",
        "eyes": "textures/gloamingforest/entity/gloaminglich64_eyes"
      },
      "geometry": {
        "default": "geometry.gloamingforest.lich"
      },
      "scripts": {
        "scale": "1.125",
        "pre_animation": [
          "variable.death_time = query.property('gloamingforest:death_time');",
          "variable.dying = variable.death_time > 0;",
          "variable.phase = query.property('gloamingforest:phase');",
          "variable.has_item = query.is_item_equipped(0);",
          "variable.limb = query.modified_move_speed * 0.75;"
        ],
        "animate": ["base_pose", "look_at_target", "legs", "arms", "death", "shake"]
      },
      "animations": {
        "base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "legs": "animation.gloamingforest.lich.legs",
        "arms": "animation.gloamingforest.lich.arms",
        "death": "animation.gloamingforest.lich.death",
        "shake": "animation.gloamingforest.lich.shake"
      },
      "render_controllers": [
        {
          "controller.render.gloamingforest.lich": "!query.property('gloamingforest:clone')"
        },
        {
          "controller.render.gloamingforest.lich_clone": "query.property('gloamingforest:clone')"
        },
        {
          "controller.render.gloamingforest.lich_clone_eyes": "query.property('gloamingforest:clone')"
        }
      ],
      "enable_attachables": true,
      "spawn_egg": {
        "base_color": "#aca489",
        "overlay_color": "#360472"
      }
    }
  }
}
