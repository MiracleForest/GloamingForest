{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "twilightforest:lich_minion",
      "materials": {
        "default": "zombie"
      },
      "textures": {
        "default": "textures/entity/zombie/zombie"
      },
      "geometry": {
        "default": "geometry.twilightforest.lich_minion"
      },
      "scripts": {
        "initialize": ["variable.gliding_speed_value = 1.0;"],
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": ["humanoid_base_pose", "look_at_target", "move", "attack_bare_hand", "bob", "base"]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack_bare_hand": "animation.zombie.attack_bare_hand",
        "bob": "animation.humanoid.bob",
        "base": "animation.twilightforest.lich_minion.base"
      },
      "render_controllers": ["controller.render.twilightforest.lich_minion"],
      "enable_attachables": true
    }
  }
}
