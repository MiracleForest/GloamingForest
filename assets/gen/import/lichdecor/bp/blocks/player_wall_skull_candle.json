{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "gloamingforest:player_wall_skull_candle",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "gloamingforest:candles": [0, 1, 2, 3, 4],
        "gloamingforest:facing": ["north", "south", "west", "east"],
        "gloamingforest:lighting": ["none", "normal", "dim", "ominous"]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 5
      },
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "gf_vanilla_block_soul_sand",
          "render_method": "opaque"
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('gloamingforest:lighting') == 'dim' && q.block_state('gloamingforest:candles') == 1",
        "components": {
          "minecraft:light_emission": 1
        }
      },
      {
        "condition": "(q.block_state('gloamingforest:lighting') == 'dim' && q.block_state('gloamingforest:candles') == 2) || (q.block_state('gloamingforest:lighting') == 'ominous' && q.block_state('gloamingforest:candles') == 1)",
        "components": {
          "minecraft:light_emission": 2
        }
      },
      {
        "condition": "(q.block_state('gloamingforest:lighting') == 'normal' && q.block_state('gloamingforest:candles') == 1) || (q.block_state('gloamingforest:lighting') == 'dim' && q.block_state('gloamingforest:candles') == 3)",
        "components": {
          "minecraft:light_emission": 3
        }
      },
      {
        "condition": "(q.block_state('gloamingforest:lighting') == 'dim' && q.block_state('gloamingforest:candles') == 4) || (q.block_state('gloamingforest:lighting') == 'ominous' && q.block_state('gloamingforest:candles') == 2)",
        "components": {
          "minecraft:light_emission": 4
        }
      },
      {
        "condition": "(q.block_state('gloamingforest:lighting') == 'normal' && q.block_state('gloamingforest:candles') == 2) || (q.block_state('gloamingforest:lighting') == 'ominous' && q.block_state('gloamingforest:candles') == 3)",
        "components": {
          "minecraft:light_emission": 6
        }
      },
      {
        "condition": "q.block_state('gloamingforest:lighting') == 'ominous' && q.block_state('gloamingforest:candles') == 4",
        "components": {
          "minecraft:light_emission": 8
        }
      },
      {
        "condition": "q.block_state('gloamingforest:lighting') == 'normal' && q.block_state('gloamingforest:candles') == 3",
        "components": {
          "minecraft:light_emission": 9
        }
      },
      {
        "condition": "q.block_state('gloamingforest:lighting') == 'normal' && q.block_state('gloamingforest:candles') == 4",
        "components": {
          "minecraft:light_emission": 12
        }
      }
    ]
  }
}
