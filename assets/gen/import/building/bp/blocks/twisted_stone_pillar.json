{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "gloamingforest:twisted_stone_pillar",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "gloamingforest:axis": ["y", "x", "z"],
        "gloamingforest:down": [false, true],
        "gloamingforest:east": [false, true],
        "gloamingforest:north": [false, true],
        "gloamingforest:south": [false, true],
        "gloamingforest:up": [false, true],
        "gloamingforest:west": [false, true]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 30
      },
      "minecraft:tags": ["minecraft:is_pickaxe_item_destructible"],
      "minecraft:map_color": "#707070",
      "minecraft:geometry": {
        "identifier": "geometry.gf.gloamingforest.block.twisted_stone_pillar.multipart",
        "bone_visibility": {
          "part0": "q.block_state('gloamingforest:axis') == 'x'",
          "part1": "q.block_state('gloamingforest:axis') == 'x' && !q.block_state('gloamingforest:east')",
          "part2": "q.block_state('gloamingforest:axis') == 'x' && !q.block_state('gloamingforest:west')",
          "part3": "(q.block_state('gloamingforest:axis') == 'y' || q.block_state('gloamingforest:axis') == 'z') && q.block_state('gloamingforest:east')",
          "part4": "(q.block_state('gloamingforest:axis') == 'y' || q.block_state('gloamingforest:axis') == 'z') && q.block_state('gloamingforest:west')",
          "part5": "q.block_state('gloamingforest:axis') == 'y'",
          "part6": "q.block_state('gloamingforest:axis') == 'y' && !q.block_state('gloamingforest:up')",
          "part7": "q.block_state('gloamingforest:axis') == 'y' && !q.block_state('gloamingforest:down')",
          "part8": "(q.block_state('gloamingforest:axis') == 'x' || q.block_state('gloamingforest:axis') == 'z') && q.block_state('gloamingforest:up')",
          "part9": "(q.block_state('gloamingforest:axis') == 'x' || q.block_state('gloamingforest:axis') == 'z') && q.block_state('gloamingforest:down')",
          "part10": "q.block_state('gloamingforest:axis') == 'z'",
          "part11": "q.block_state('gloamingforest:axis') == 'z' && !q.block_state('gloamingforest:north')",
          "part12": "q.block_state('gloamingforest:axis') == 'z' && !q.block_state('gloamingforest:south')",
          "part13": "(q.block_state('gloamingforest:axis') == 'x' || q.block_state('gloamingforest:axis') == 'y') && q.block_state('gloamingforest:north')",
          "part14": "(q.block_state('gloamingforest:axis') == 'x' || q.block_state('gloamingforest:axis') == 'y') && q.block_state('gloamingforest:south')"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "gf_block_twisted_stone_pillar",
          "render_method": "alpha_test"
        },
        "t_gloamingforest_block_twisted_stone_cap_end": {
          "texture": "gf_block_twisted_stone_cap_end",
          "render_method": "alpha_test"
        },
        "t_gloamingforest_block_twisted_stone_cap_side": {
          "texture": "gf_block_twisted_stone_cap_side",
          "render_method": "alpha_test"
        },
        "t_gloamingforest_block_twisted_stone_pillar": {
          "texture": "gf_block_twisted_stone_pillar",
          "render_method": "alpha_test"
        }
      },
      "minecraft:light_dampening": 0
    }
