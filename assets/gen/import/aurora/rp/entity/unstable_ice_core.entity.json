{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gloamingforest:unstable_ice_core",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/gloamingforest/entity/iceexploder"
      },
      "geometry": {
        "default": "geometry.gloamingforest.unstable_ice_core.swell"
      },
      "scripts": {
        "animate": ["base", "spikes", "swell", "snow_aura"],
        "pre_animation": [
          "v.dying = q.property('gloamingforest:dying');",
          "v.swell = 1 + math.sin(v.dying * 100 * 57.29578) * v.dying * 0.01;",
          "v.f4 = v.dying > 0 ? 1 : 0;",
          "v.swell_xz = (1 + v.f4 * 0.4) * v.swell;",
          "v.swell_y = (1 + v.f4 * 0.1) / v.swell;"
        ]
      },
      "animations": {
        "base": "animation.gloamingforest.unstable_ice_core.base",
        "spikes": "animation.gloamingforest.unstable_ice_core.spikes",
        "swell": "animation.gloamingforest.unstable_ice_core.swell",
        "snow_aura": "controller.animation.gloamingforest.unstable_ice_core.snow"
      },
      "render_controllers": ["controller.render.gloamingforest.unstable_ice_core"],
      "spawn_egg": {
        "base_color": "#9aacf5",
        "overlay_color": "#9b0fa5"
      },
      "particle_effects": {
        "snow_aura": "gloamingforest:aurora_snow_core"
      }
    }
  }
}
