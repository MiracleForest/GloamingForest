{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "twilightforest:snow_queen",
      "materials": {
        "default": "entity_alphatest",
        "shields": "entity_alphatest"
      },
      "textures": {
        "default": "textures/twilightforest/entity/snowqueen",
        "shields": "textures/blocks/ice_packed"
      },
      "geometry": {
        "default": "geometry.twilightforest.snow_queen",
        "shields": "geometry.twilightforest.snow_queen_shields"
      },
      "scripts": {
        "scale": "1.2",
        "pre_animation": [
          "v.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.gliding_speed_value = 1.0;",
          "v.attack_time = v.attack_time ?? 0;",
          "v.shield_last = v.shield_last ?? -1;",
          "v.shield_sync = (q.property('twilightforest:shield_tick') != v.shield_last) ? q.life_time : (v.shield_sync ?? q.life_time);",
          "v.shield_last = q.property('twilightforest:shield_tick');",
          "v.shield_t = q.property('twilightforest:shield_tick') + (q.life_time - v.shield_sync) * 20;"
        ],
        "animate": [
          "humanoid_base_pose",
          "look_at_target",
          "move",
          "base",
          "phase",
          "shields_spin",
          {
            "attack": "v.attack_time > 0.0"
          },
          "snow_aura"
        ]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack": "animation.humanoid.attack.rotations",
        "bob": "animation.humanoid.bob",
        "base": "animation.twilightforest.snow_queen.base",
        "beam_arms": "animation.twilightforest.snow_queen.beam_arms",
        "arms_up": "animation.twilightforest.snow_queen.arms_up",
        "phase": "controller.animation.twilightforest.snow_queen.phase",
        "shields_spin": "animation.twilightforest.snow_queen.shields",
        "snow_aura": "controller.animation.twilightforest.ice_mob.snow"
      },
      "render_controllers": ["controller.render.default", "controller.render.twilightforest.snow_queen_shields"],
      "spawn_egg": {
        "base_color": "#b1b2d4",
        "overlay_color": "#87006e"
      },
      "particle_effects": {
        "snow_aura": "gloamingforest:aurora_snow_queen"
      }
    }
  }
}
